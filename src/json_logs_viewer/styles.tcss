Screen {
    layout: vertical;
}

/* The search bar floats on its own layer over the top of the list.
   Docked in the normal layout it pushed the list down and shrank it
   whenever it opened, so the log lines jumped. Textual's own layers are
   listed too: a layer missing from this list sorts to the bottom, which
   would put toasts and tooltips under the search bar. */
MainScreen {
    layers: default search badge _loading _toastrack _tooltips;
}

/* The "↓ N new lines" badge floats at the bottom-right of the list on its
   own layer (the pane's align places it; the list doesn't move). The
   margin keeps the list's scrollbars visible. */
#logs-pane {
    align: right bottom;
}

#new-lines {
    layer: badge;
    width: auto;
    height: 1;
    margin: 0 1 1 0;
    padding: 0 1;
    background: $primary;
    color: $text;
    text-style: bold;
}

#search {
    layer: search;
    height: 3;
    border: solid $primary;
    dock: top;
}

#logs-pane {
    height: 1fr;
    border: solid $primary;
}

#logs {
    height: 1fr;
    scrollbar-size: 1 1;
    padding: 0 0 0 1;
}

#status {
    height: auto;
    dock: bottom;
}

ToastRack {
    dock: top;
    align: right top;
    margin-top: 1;
    margin-bottom: 0;
}

/* Textual's command palette is full width by default; on a wide terminal
   that stretches every entry across the screen. Centre it at a readable
   width instead (the palette already centres its contents). */
CommandPalette > Vertical {
    width: 75%;
    min-width: 60;
    max-width: 100;
}
