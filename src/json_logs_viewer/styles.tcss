Screen {
    layout: vertical;
}

#search {
    height: 3;
    border: solid $primary;
    dock: top;
}

#logs-pane {
    height: 1fr;
    border: solid $primary;
}

#logs {
    height: 1fr;
    scrollbar-size: 1 1;
    padding: 0 0 0 1;
}

#status {
    height: auto;
    dock: bottom;
}

ToastRack {
    dock: top;
    align: right top;
    margin-top: 1;
    margin-bottom: 0;
}
